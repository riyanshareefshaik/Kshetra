# Copy to .env and fill in. Never commit .env.
# Every key below comes from a FREE tier; see README "Getting the free keys".

# --- Required by the brief ---
GEE_PROJECT=your-earth-engine-cloud-project-id
GEMINI_API_KEY=your-gemini-free-tier-key
GROQ_API_KEY=your-groq-free-tier-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
DATA_GOV_API_KEY=your-data-gov-in-key
BHASHINI_KEY=your-bhashini-ulca-api-key
BHASHINI_USER_ID=your-bhashini-user-id

# --- NISAR radar (free accounts, needed for the NISAR layer) ---
# L-band: NASA Earthdata login (urs.earthdata.nasa.gov) -> generate a user token
EARTHDATA_TOKEN=your-nasa-earthdata-token
# S-band: ISRO Bhoonidhi (bhoonidhi.nrsc.gov.in) registered account
BHOONIDHI_USERNAME=your-bhoonidhi-username
BHOONIDHI_PASSWORD=your-bhoonidhi-password

# --- Database ---
# Local docker-compose default; for Supabase use its "Session pooler" connection string.
DATABASE_URL=postgresql://kshetra:kshetra@localhost:5432/kshetra

# --- LLM routing (all free) ---
LLM_PROVIDER_ORDER=groq,gemini,ollama
OLLAMA_URL=http://localhost:11434
# Open-weight models only: gpt-oss and Qwen2.5-7B are Apache 2.0
OLLAMA_MODEL=qwen2.5:7b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
# Local speech-to-text fallback (faster-whisper, MIT): tiny | base | small | medium
WHISPER_MODEL=small

# --- Frontend ---
VITE_API_URL=http://localhost:8000
